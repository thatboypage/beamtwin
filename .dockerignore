# Files Docker should NOT copy into the image: keeps it small, fast to build, and free of
# anything private or irrelevant to running the web app.
.git
.github
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
pytest-cache-files-*
.ipynb_checkpoints
.vscode
.idea
data
notebooks
docs
tests
models/*
!models/surrogate_hybrid.npz
*.zip
